# Environment configuration for Agent 65 Student Helpdesk Backend

# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/student_helpdesk
USE_IN_MEMORY_DB=true

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# AI Model Provider: mock (default, 0 API keys) | local (Ollama then cloud fallback) | cloud (Gemini/Groq)
LLM_PROVIDER=mock
LOCAL_MODEL_URL=http://localhost:11434/api/generate
LOCAL_MODEL_NAME=llama3

# Optional cloud credentials. Keep real values only in BACKEND/.env or deployment secrets.
LLM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
